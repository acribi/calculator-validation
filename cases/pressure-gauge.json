      "id": "pressure-gauge/nist-sp811-inH2O",
      "calculator": "pressure-gauge",
      "operation": "head-correction",
      "title": "Conventional inch of water in pascals",
      "inputs": {
        "fluid_density": {
          "value": 1000,
          "unit": "kg/m³"
