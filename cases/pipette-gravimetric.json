      "operation": "water-density",
      "title": "Air-free water density at 10 °C (Tanaka)",
      "inputs": {
        "water_temperature": {
          "value": 10,
          "unit": "°C"
        },
        "air_saturated": {
          "value": false,
          "unit": "boolean"
        }
      },
      "expected": {
        "water_density": {
          "value": 0.9997027,
          "unit": "g/cm³",
          "tolerance": 6e-9,
          "published": "0.99970270"
        }
      },
      "source": {
        "document": "NIST IR 7383-2019 Selected Procedures for Volumetric Calibrations, GLP 10",
        "publisher": "NIST Office of Weights and Measures",
        "edition": "2019",
        "url": "https://nvlpubs.nist.gov/nistpubs/ir/2019/NIST.IR.7383-2019.pdf",
        "kind": "official",
        "location": "GLP 10, Table 2"
      }
    },
