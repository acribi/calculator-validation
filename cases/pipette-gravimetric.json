    {
      "id": "pipette-gravimetric/eppendorf-sop-z-20C",
      "calculator": "pipette-gravimetric",
      "operation": "z-factor",
      "title": "Z correction factor at 20 °C and 1013 hPa",
      "inputs": {
        "water_temperature": {
          "value": 20,
          "unit": "°C"
        },
        "air_temperature": {
          "value": null,
          "unit": "°C"
        },
        "pressure": {
          "value": 1013,
          "unit": "hPa"
        },
        "relative_humidity": {
          "value": 50,
          "unit": "%"
        }
      },
      "expected": {
        "z_factor": {
          "value": 1.0029,
          "unit": "µL/mg",
          "tolerance": 0.00005,
          "published": "1.0029"
        }
      },
      "source": {
        "document": "Eppendorf, Standard Operating Procedure for manual dispensing systems",
        "publisher": "Eppendorf",
        "edition": "2019 (German version)",
        "url": "https://www.eppendorf.com/media/MAIN/03-Service-Support/Pipette-Service/Eppendorf_Liquid-Handling_SOP_Pipettes_Standard-operating-procedure-manual-dispensing-systems.pdf",
        "kind": "secondary",
        "note": "Manufacturer document.",
        "location": "§8.2, table of Z factors"
      },
      "notes": "Air temperature taken equal to the water temperature. The source does not state the humidity; 50 % is assumed. The reference implementation reproduces at least 98 % of the 217 table cells exactly after rounding to 4 decimals, all within 0.00006."
    },
