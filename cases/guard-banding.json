      "source": {
        "document": "Dobbert, M., A Guard-Band Strategy for Managing False-Accept Risk, NCSL International Workshop & Symposium 2008 (Keysight white paper 5991-1267EN)",
        "publisher": "Keysight Technologies",
        "edition": "2008 (white paper published 2018-12-19)",
        "url": "https://keysight.zinfi.net/concierge/OEMs/keysight/wwwcontent/Syndication/pdf/MeasurementFundamentasKR/5991-1267.pdf",
        "kind": "secondary",
        "note": "Original paper of the managed guard band method; cited by Global ACI-TECH-1-002.",
        "location": "Table 1, pp. 5–6"
